// app/static/js/main.js

console.log("HR Interview Assistant loaded");

document.addEventListener("DOMContentLoaded", function () {
    const form = document.querySelector(".interview-form");
    const currentQuestionEl = document.querySelector("#current-question");

    if (!form || !currentQuestionEl) {
        return;
    }

    const vacancyId = form.dataset.vacancyId || "";
    const vacancyTitle = form.dataset.vacancyTitle || "Неизвестная вакансия";

    const nameInput = form.querySelector("#candidate-name");
    const contactInput = form.querySelector("#candidate-contact");
    const answerInput = form.querySelector("#candidate-answer");
    const consentCheckbox = form.querySelector("#candidate-consent");

    const blockLabel = document.querySelector("[data-question-block-label]");
    const progressLabel = document.querySelector("[data-question-progress]");
    const prevBtn = document.querySelector("[data-question-prev]");
    const nextBtn = document.querySelector("[data-question-next]");
    const submitBtn = form.querySelector('button[type="submit"]');

    const note = document.createElement("p");
    note.className = "form-note";

    const questions = [];

    const collectFromList = (selector, blockName) => {
        const list = document.querySelector(selector);
        if (!list) return;

        list.querySelectorAll("li").forEach((li) => {
            questions.push({
                text: li.textContent.trim(),
                block: blockName,
            });
        });
    };

    collectFromList("#general-questions-list", "Общие");
    collectFromList("#professional-questions-list", "Профессиональные");
    collectFromList("#behavioral-questions-list", "Поведенческие");

    let currentIndex = 0;
    let interviewFinished = false;
    const answers = new Array(questions.length).fill("");

    function ensureNoteAttached() {
        if (!note.parentNode) {
            form.appendChild(note);
        }
    }

    function setError(message) {
        note.textContent = message;
        note.style.color = "#b91c1c";
        ensureNoteAttached();
    }

    function setSuccess(message) {
        note.textContent = message;
        note.style.color = "#047857";
        ensureNoteAttached();
    }

    function saveCurrentAnswer() {
        if (questions.length === 0 || interviewFinished) return;
        answers[currentIndex] = answerInput.value.trim();
    }

    function renderCurrentQuestion() {
        if (questions.length === 0) {
            currentQuestionEl.textContent = "Вопросы не найдены.";
            if (blockLabel) blockLabel.textContent = "";
            if (progressLabel) progressLabel.textContent = "";
            if (prevBtn) prevBtn.disabled = true;
            if (nextBtn) nextBtn.disabled = true;
            if (submitBtn) submitBtn.disabled = true;
            return;
        }

        if (interviewFinished) {
            currentQuestionEl.textContent = "Интервью завершено. Новый отчёт уже сохранён в архиве.";
            if (blockLabel) blockLabel.textContent = "";
            if (progressLabel) progressLabel.textContent = "";
            if (prevBtn) prevBtn.disabled = true;
            if (nextBtn) nextBtn.disabled = true;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = "Интервью завершено";
            }
            return;
        }

        const q = questions[currentIndex];
        currentQuestionEl.textContent = q.text;

        if (blockLabel) {
            blockLabel.textContent = q.block;
        }

        if (progressLabel) {
            progressLabel.textContent = `Вопрос ${currentIndex + 1} из ${questions.length}`;
        }

        answerInput.value = answers[currentIndex] || "";

        if (prevBtn) {
            prevBtn.disabled = currentIndex === 0;
            prevBtn.style.opacity = prevBtn.disabled ? "0.6" : "1";
        }

        if (nextBtn) {
            nextBtn.disabled = currentIndex === questions.length - 1;
            nextBtn.style.opacity = nextBtn.disabled ? "0.6" : "1";
        }

        if (submitBtn) {
            if (currentIndex === questions.length - 1) {
                submitBtn.textContent = "Завершить интервью и сохранить отчёт";
            } else {
                submitBtn.textContent = "Отправить ответ и перейти к следующему вопросу";
            }
            submitBtn.disabled = false;
        }
    }

    function goToNextQuestion() {
        if (currentIndex < questions.length - 1) {
            currentIndex += 1;
            renderCurrentQuestion();
        }
    }

    function buildInterviewSummary(candidateName) {
        const filledAnswers = questions
            .map((question, index) => {
                const answer = (answers[index] || "").trim();
                if (!answer) return null;

                return [
                    `### ${question.block}`,
                    `**Вопрос:** ${question.text}`,
                    `**Ответ кандидата:** ${answer}`,
                ].join("\n");
            })
            .filter(Boolean);

        if (filledAnswers.length === 0) {
            return `По кандидату ${candidateName} пока не зафиксированы содержательные ответы в интервью.`;
        }

        return [
            `Кандидат: ${candidateName}.`,
            `Ниже приведены зафиксированные ответы по ходу интервью:`,
            "",
            filledAnswers.join("\n\n"),
        ].join("\n");
    }

    async function sendFinalReport(payload) {
        const response = await fetch("/api/reports/save", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
        });

        let result = {};
        try {
            result = await response.json();
        } catch (error) {
            result = {};
        }

        if (!response.ok) {
            throw new Error(result.message || "Не удалось сохранить отчёт.");
        }

        return result;
    }

    if (prevBtn) {
        prevBtn.addEventListener("click", function () {
            if (interviewFinished) return;
            saveCurrentAnswer();

            if (currentIndex > 0) {
                currentIndex -= 1;
                renderCurrentQuestion();
            }
        });
    }

    if (nextBtn) {
        nextBtn.addEventListener("click", function () {
            if (interviewFinished) return;
            saveCurrentAnswer();
            goToNextQuestion();
        });
    }

    form.addEventListener("submit", async function (event) {
        event.preventDefault();

        if (interviewFinished) {
            return;
        }

        const candidateName = nameInput.value.trim();
        const candidateContact = contactInput ? contactInput.value.trim() : "";
        const currentAnswer = answerInput.value.trim();

        if (!candidateName || !currentAnswer) {
            setError("Заполните имя кандидата и ответ перед отправкой.");
            return;
        }

        if (consentCheckbox && !consentCheckbox.checked) {
            setError("Поставьте отметку о согласии на обработку персональных данных.");
            return;
        }

        saveCurrentAnswer();

        const isLastQuestion = currentIndex === questions.length - 1;

        if (!isLastQuestion) {
            setSuccess(`Ответ для вопроса ${currentIndex + 1} сохранён.`);
            goToNextQuestion();
            return;
        }

        if (submitBtn) {
            submitBtn.disabled = true;
        }
        if (prevBtn) {
            prevBtn.disabled = true;
        }
        if (nextBtn) {
            nextBtn.disabled = true;
        }

        setSuccess("Сохраняем итоговый отчёт...");

        try {
            const summary = buildInterviewSummary(candidateName);

            const payload = {
                vacancy_id: vacancyId,
                vacancy_title: vacancyTitle,
                candidate_name: candidateName,
                candidate_contact: candidateContact,
                summary: summary,
                recommendation: "Требует дополнительной оценки",
            };

            const result = await sendFinalReport(payload);

            interviewFinished = true;

            setSuccess(`Интервью завершено. Отчёт сохранён: ${result.filename}`);

            answerInput.value = "";
            answerInput.disabled = true;
            nameInput.disabled = true;

            if (contactInput) {
                contactInput.disabled = true;
            }

            if (consentCheckbox) {
                consentCheckbox.disabled = true;
            }

            renderCurrentQuestion();
        } catch (error) {
            setError(error.message || "Ошибка при сохранении отчёта.");

            if (submitBtn) {
                submitBtn.disabled = false;
            }
            if (prevBtn) {
                prevBtn.disabled = false;
            }
            if (nextBtn) {
                nextBtn.disabled = currentIndex === questions.length - 1;
            }
        }
    });

    renderCurrentQuestion();
});